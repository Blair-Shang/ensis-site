{
  "name": "niuma-site",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "NiuMa 官方网站（niuma007.com）— 工作室品牌站与产品矩阵入口",
  "scripts": {
    "dev": "vite",
    "dev:server": "go run -C server ./cmd/server",
    "build": "vue-tsc --noEmit && vite build",
    "build:server": "go build -C server -o ../run/niuma-site.exe ./cmd/server",
    "build:all": "powershell -ExecutionPolicy Bypass -File script/build.ps1",
    "ci": "pnpm typecheck && pnpm test:server",
    "pack:release": "bash script/pack-release.sh",
    "start": "powershell -ExecutionPolicy Bypass -File script/start.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File script/stop.ps1",
    "restart": "powershell -ExecutionPolicy Bypass -File script/restart.ps1",
    "test:server": "go test -C server ./...",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@niuma/ui": "link:../niuma-ui",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.6"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vue": "*"
      },
      "ignoreMissing": ["vue"]
    }
  }
}
