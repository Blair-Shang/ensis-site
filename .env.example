# 前端：开发时留空，走 Vite 代理 /api → :8080；生产同域反代也留空
VITE_SITE_API_BASE=

# 版本 / 更新说明 / 反馈（ensis-cloud，含 /niuma/cloud 前缀）
# 生产：https://www.niuma007.com/niuma/cloud
VITE_CLOUD_API_BASE=http://127.0.0.1:8090/niuma/cloud

# cloud 不可达时的展示回落；安装包跳转以 server config/app.yaml → cloud.api_base 为准
# VITE_DOWNLOAD_USE_DIRECT=true 时才会用下面的直链（应急，不跟随流水线新版本）
VITE_DOWNLOAD_WIN_URL=
VITE_DOWNLOAD_VERSION=
